# --- Telegram / MTProto (obrigatórias) ---
# Obtenha API_ID e API_HASH em https://my.telegram.org
API_ID=
API_HASH=
# String de sessão do Pyrogram (gerada uma vez com uma conta autorizada a participar da chamada).
# NUNCA versionar ou logar este valor.
SESSION_STRING=
# ID do chat/grupo/canal onde a chamada de vídeo será transmitida.
CHAT_ID=
STREAM_CHAT_ID=

# --- Autorização do bot ---
# Lista de user_id do Telegram autorizados a controlar o bot, separados por vírgula,
# ou "all" para autorizar qualquer membro ATUAL do grupo em CHAT_ID (checado em
# tempo real via get_chat_member — não é "qualquer usuário do Telegram").
# Se vazio, NENHUM usuário consegue executar comandos de controle.
AUTHORIZED_USER_IDS=
# user_id do Telegram autorizado a gerenciar addons (/addon enable|disable|reload|uninstall).
# Instalar/remover addons roda código de terceiro no mesmo processo que tem a SESSION_STRING,
# por isso é restrito a um único operador mesmo com AUTHORIZED_USER_IDS=all.
# Vazio nega a todos (ninguém consegue gerenciar addons, mas /addon info continua liberado
# para quem já está em AUTHORIZED_USER_IDS).
OWNER_USER_ID=

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
# Política de rotação do Loguru: tamanho ("10 MB") ou tempo ("1 day", "00:00").
LOG_ROTATION=10 MB
# Política de retenção de logs antigos.
LOG_RETENTION=7 days

# --- FFmpeg / mídia ---
FFMPEG_PATH=ffmpeg
MEDIA_PATH=media
# Pasta do Windows/host montada como /app/media no container.
# Máximo de processos FFmpeg simultâneos (v1 é single-chamada; mantenha em 1).
FFMPEG_MAX_CONCURRENT=1
FFMPEG_HEALTHCHECK_INTERVAL_SECONDS=5.0
# Prazo (segundos) para o FFmpeg encerrar de forma graciosa (SIGTERM) antes de SIGKILL.
FFMPEG_TERMINATE_TIMEOUT_SECONDS=5.0

# --- Fila (player) ---
QUEUE_MAX_ITEMS=50
QUEUE_DATA_PATH=data/queue.json

# --- Retry / resiliência (reconexão de chamada e FFmpeg) ---
RETRY_BASE_DELAY_SECONDS=2.0
RETRY_MAX_DELAY_SECONDS=60.0
RETRY_MAX_ATTEMPTS=8
RETRY_JITTER_SECONDS=1.0

# --- Addons ---
ADDONS_PATH=addons
ADDONS_STATE_PATH=data/addons_state.json
ADDONS_CONFIG_PATH=config/addons
ADDON_SEARCH_TIMEOUT_SECONDS=10.0
ADDON_STREAMS_TIMEOUT_SECONDS=10.0
ADDON_SEARCH_CACHE_TTL_SECONDS=300.0

# --- TMDB (metadados de filmes) ---
# Chave da API TMDB v3 (bearer token). Obtenha em https://www.themoviedb.org/settings/api.
# Vazio desativa a integração por completo (/find segue funcionando só com o que os addons já devolvem).
TMDB_API_KEY=
# Idioma (ISO 639-1/BCP 47) dos metadados retornados pelo TMDB.
TMDB_LANGUAGE=pt-BR
TMDB_REQUEST_TIMEOUT_SECONDS=10.0

# --- Bot (BotFather) ---
# Token do bot obtido com @BotFather. Habilita um segundo client, exclusivo
# para /find e /pick, capaz de enviar botões inline reais (o Telegram
# descarta silenciosamente botões em mensagens enviadas pela SESSION_STRING,
# uma conta de usuário). Vazio mantém /find e /pick funcionando como sempre,
# só em texto, no client de sessão.
# IMPORTANTE: adicione este bot como membro do grupo/canal em CHAT_ID com
# permissão de enviar mensagens — sem isso /find falha ao responder.
BOT_TOKEN=

# --- qBittorrent / Torrents ---
# Suporte a streams que só trazem infoHash/magnet (ex.: Torrentio sem debrid
# configurado) — baixados via a Web API do qBittorrent em vez de descartados.
QBITTORRENT_HOST=localhost
QBITTORRENT_PORT=8080
QBITTORRENT_USERNAME=admin
QBITTORRENT_PASSWORD=
# Categoria aplicada aos torrents adicionados pelo bot (opcional).
QBITTORRENT_CATEGORY=
# IMPORTANTE: precisa ser um caminho acessível LOCALMENTE pelo processo do
# bridge (mesma máquina, ou mesmo volume compartilhado em Docker) — o FFmpeg
# lê o arquivo direto do disco enquanto ele ainda está sendo baixado, sem
# cópia. Recomendado manter dentro de MEDIA_PATH.
QBITTORRENT_SAVE_PATH=media/torrents
QBITTORRENT_LOCAL_PATH=media/torrents
# Buffer mínimo (MB) baixado do arquivo antes de liberar ao FFmpeg.
TORRENT_BUFFER_MB=50.0
# Prazo (segundos) para metadata chegar ou o buffer mínimo ser atingido antes
# de desistir do candidato e tentar o próximo.
TORRENT_TIMEOUT_SECONDS=60.0
# Remove o torrent do qBittorrent ao fim da reprodução. False mantém em seed.
REMOVE_TORRENT_AFTER_PLAY=False
